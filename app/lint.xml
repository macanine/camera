<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!-- Dependabot owns dependency upgrades so lint gates stay deterministic offline. -->
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
    <!-- Target SDK is a deliberate compatibility policy, not a network-dependent upgrade gate. -->
    <issue id="OldTargetApi">
        <ignore path="build.gradle.kts" />
    </issue>
    <!-- Adaptive icons require an API-qualified directory even when minSdk is 26. -->
    <issue id="ObsoleteSdkInt">
        <ignore path="src/main/res/mipmap-anydpi-v26" />
    </issue>
</lint>
